{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "outDir": "dist/renderer",
    "rootDir": "src/renderer",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "types": []
  },
  "include": ["src/renderer/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
